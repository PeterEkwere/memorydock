[Unit]
Description=MemoryDock Grace MCP presentation dashboard
After=network-online.target

[Service]
Type=simple
User=grace
Group=grace
WorkingDirectory=/opt/memorydock
ExecStart=/usr/bin/python3 /opt/memorydock/dock.py --state /var/lib/memorydock serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/memorydock
Environment=PYTHONDONTWRITEBYTECODE=1
MemoryMax=600M
TasksMax=64

[Install]
WantedBy=multi-user.target
